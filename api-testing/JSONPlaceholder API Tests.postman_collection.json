        {
          "name": "TC-API-POSTS-01 Get all posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\npm.test(\"Response time is below 2000 ms\", function () {\n    pm.expect(pm.response.responseTime).to.be.below(2000);\n});\npm.test(\"Content-Type is JSON\", function () {\n    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");\n});\n\nconst posts = pm.response.json();\npm.test(\"Response is an array of 100 posts\", function () {\n    pm.expect(posts).to.be.an(\"array\").with.lengthOf(100);\n});\npm.test(\"First post has the expected fields and data types\", function () {\n    pm.expect(posts[0]).to.have.all.keys(\"userId\", \"id\", \"title\", \"body\");\n    pm.expect(posts[0].userId).to.be.a(\"number\");\n    pm.expect(posts[0].id).to.be.a(\"number\");\n    pm.expect(posts[0].title).to.be.a(\"string\").and.not.empty;\n    pm.expect(posts[0].body).to.be.a(\"string\").and.not.empty;\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            },
            "description": "Expected: 200 and a list of 100 posts. Each post has userId, id, title, and body with the correct data types."
          },
          "response": []
        },
