        {
          "name": "TC-API-POSTS-04 Create a post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response time is below 2000 ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "pm.test(\"Content-Type is JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
                  "});",
                  "",
                  "const sent = JSON.parse(pm.request.body.raw);",
                  "const created = pm.response.json();",
                  "pm.test(\"Response echoes the data that was sent\", function () {",
                  "    pm.expect(created.title).to.eql(sent.title);",
                  "    pm.expect(created.body).to.eql(sent.body);",
                  "    pm.expect(created.userId).to.eql(sent.userId);",
                  "});",
                  "pm.test(\"A new id is returned\", function () {",
                  "    pm.expect(created.id).to.be.a(\"number\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"QA portfolio test post\",\n  \"body\": \"Created from the Postman collection\",\n  \"userId\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "posts"
              ]
            },
            "description": "Expected: 201 and the created post echoes the data that was sent, with a new id. JSONPlaceholder does not save the data, so only the response is verified."
          },
          "response": []
        },
